# Optional — enables AI Co-pilot when running `npm run dev`.
# Create `.env.local` with the same line and your real key (gitignored).
ANTHROPIC_API_KEY=

# Optional — production build: HTTPS URL of *your* serverless proxy to Anthropic
# (Vercel serverless, etc.). The static app cannot call api.anthropic.com from the browser (CORS).
# VITE_ANTHROPIC_URL=
